# Find these values in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Required to create staff sign-ins and persist Diagnostics failures.
# Without it, role changes still work and failures fall back to server logs.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Find these values in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Required by the Staff Accounts page to create new employee sign-ins.
# Without it, role changes still work but adding an account does not.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
